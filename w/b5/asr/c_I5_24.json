005594, "laugh"], [17.209999969005594, 17.289999952316293, "at"], [17.289999952316293, 17.68999995231627, "him."]]}, {"s": 18.31400000000002, "e": 20.390000000000043, "t": "Because of the thinness of his calves.", "w": [[18.393999998211882, 18.633999992847464, "Because"], [18.633999992847464, 18.713999976158163, "of"], [18.713999976158163, 18.874000002384207, "the"], [18.874000002384207, 19.35399996185305, "thinness"], [19.35399996185305, 19.513999928474448, "of"], [19.513999928474448, 19.674000014305136, "his"], [19.674000014305136, 20.074000014305113, "calves."]]}, {"s": 20.938000000000045, "e": 25.670000000000073, "t": "It's like a stick. See, what is this? Look at this man. Is this a man or a stick?", "w": [[20.938000000000045, 21.177999994635627, "It's"], [21.177999994635627, 21.337999976158187, "like"], [21.337999976158187, 21.41799998927121, "a"], [21.41799998927121, 22.21799998927122, "stick."], [22.29800001430516, 22.617999947547958, "See,"], [22.617999947547958, 22.697999990463302, "what"], [22.697999990463302, 22.8579999570847, "is"], [22.8579999570847, 23.337999856948898, "this?"], [23.337999856948898, 23.497999942779586, "Look"], [23.497999942779586, 23.658000028610275, "at"], [23.658000028610275, 23.817999876022384, "this"], [23.817999876022384, 24.13799980926518, "man."], [24.13799980926518, 24.29799989509587, "Is"], [24.29799989509587, 24.45799998092656, "this"], [24.45799998092656, 24.537999904632613, "a"], [24.537999904632613, 24.697999990463302, "man"], [24.697999990463302, 24.85799983787541, "or"], [24.85799983787541, 25.0179999237061, "a"], [25.0179999237061, 25.417999923706077, "stick?"]]}, {"s": 26.090000000000032, "e": 29.79800000000006, "t": "And they start to laugh at him. And the Prophet tells these men,", "w": [[26.090000000000032, 26.249999996423753, "And"], [26.249999996423753, 26.409999992847474, "they"], [26.409999992847474, 26.569999989271196, "start"], [26.569999989271196, 26.650000002384218, "to"], [26.650000002384218, 26.889999952316316, "laugh"], [26.889999952316316, 27.04999997854236, "at"], [27.04999997854236, 27.609999980926546, "him."], [27.609999980926546, 27.6899999046326, "And"], [27.6899999046326, 27.769999947547944, "the"], [27.769999947547944, 28.569999947547956, "Prophet"], [28.81000002861026, 28.96999987602237, "tells"], [28.96999987602237, 29.12999996185306, "these"], [29.12999996185306, 29.529999961853036, "men,"]]}, {"s": 31.274, "e": 33.41399999999999, "t": "Half of Abdullah ibn Nasirud.", "w": [[31.433999996423722, 31.834000002384187, "Half"], [31.834000002384187, 31.993999969005586, "of"], [31.993999969005586, 32.47399992847443, "Abdullah"], [32.47399992847443, 32.71399993801117, "ibn"], [32.71399993801117, 33.11399993801115, "Nasirud."]]}, {"s": 34.153999999999996, "e": 36.870000000000005, "t": "is more heavier in the sight of Allah than the mountain of Uhat.", "w": [[34.153999999999996, 34.39399999463558, "is"], [34.39399999463558, 34.55399997615814, "more"], [34.55399997615814, 35.033999995231625, "heavier"], [35.033999995231625, 35.113999978542324, "in"], [35.113999978542324, 35.193999961853024, "the"], [35.193999961853024, 35.43399997138977, "sight"], [35.43399997138977, 35.51400001430511, "of"], [35.51400001430511, 35.83399994754791, "Allah"], [35.83399994754791, 35.91399999046325, "than"], [35.91399999046325, 35.99399991416931, "the"], [35.99399991416931, 36.313999847412106, "mountain"], [36.313999847412106, 36.39400000953674, "of"], [36.39400000953674, 36.79400000953672, "Uhat."]]}, {"s": 37.93000000000001, "e": 40.32600000000002, "t": "What happened? He didn't do leg day.", "w": [[37.93000000000001, 38.16999999463559, "What"], [38.16999999463559, 38.889999978542335, "happened?"], [38.889999978542335, 39.05000000476838, "He"], [39.05000000476838, 39.29000001430512, "didn't"], [39.29000001430512, 39.529999904632575, "do"], [39.529999904632575, 39.84999995708466, "leg"], [39.84999995708466, 40.24999995708464, "day."]]}, {"s": 41.226, "e": 42.918000000000006, "t": "Huh? He wasn't exercising enough.", "w": [[41.226, 41.62599997615814, "Huh?"], [41.62599997615814, 41.70599998927116, "He"], [41.70599998927116, 41.945999969005584, "wasn't"], [41.945999969005584, 42.425999928474425, "exercising"], [42.425999928474425, 42.8259999284744, "enough."]]}, {"s": 44.52200000000005, "e": 46.214000000000055, "t": "Yes, he didn't show off his muscles.", "w": [[44.52200000000005, 44.84199999284749, "Yes,"], [44.84199999284749, 44.92199997615819, "he"], [44.92199997615819, 45.082000002384234, "didn't"], [45.082000002384234, 45.24199996900563, "show"], [45.24199996900563, 45.40199999523168, "off"], [45.40199999523168, 45.561999961853076, "his"], [45.561999961853076, 45.96199996185305, "muscles."]]}, {"s": 46.698000000000036, "e": 63.33400000000006, "t": "But there was a muscle that the Prophet appreciated and Allah appreciated more than this. The bravery to stand up for the haqq, for the truth, and not to back down and not to cower away and not to lie and twist and say, No, not really, maybe, but to say the truth as it is.", "w": [[46.698000000000036, 46.93799999463562, "But"], [46.93799999463562, 47.01799999284748, "there"], [47.01799999284748, 47.09799997615818, "was"], [47.09799997615818, 47.25800000238422, "a"], [47.25800000238422, 47.577999995231664, "muscle"], [47.577999995231664, 47.73799996185306, "that"], [47.73799996185306, 47.81800000476841, "the"], [47.81800000476841, 48.61800000476842, "Prophet"], [48.77799992370609, 49.25799994277958, "appreciated"], [49.25799994277958, 49.418000028610265, "and"], [49.418000028610265, 49.73799996185306, "Allah"], [49.73799996185306, 50.21799998092655, "appreciated"], [50.21799998092655, 50.37799982833866, "more"], [50.37799982833866, 50.6179998378754, "than"], [50.6179998378754, 51.417999790191686, "this."], [51.417999790191686, 51.65800003814701, "The"], [51.65800003814701, 52.37799982833866, "bravery"], [52.37799982833866, 52.53799967575077, "to"], [52.53799967575077, 52.77799992370609, "stand"], [